---
layout: null
---
[
  {% for post in site.posts %}
    {% capture star_output %}{% include stars.html rating=post.rating %}{% endcapture %}
    {
      "title"       : {{ post.title | jsonify }},
      "customdesc"  : {{ post.customdesc | jsonify }},
      "genre"       : {{ post.genre | join: ', ' | jsonify }},
      "author"      : {{ post.author | jsonify }},
      "category"    : {{ post.category | jsonify }},
      "tags"        : {{ post.tags | join: ', ' | jsonify }},
      "url"         : {{ site.baseurl | append: post.url | jsonify }},
      "date"        : {{ post.date | date: "%Y-%m-%d" | jsonify }},

      "image"       : {{ post.image | jsonify }},

      "rating"      : {{ post.rating | jsonify }},
      "stars_html"  : {{ star_output | strip | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]